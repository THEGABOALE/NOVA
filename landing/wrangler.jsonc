{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova",
  "compatibility_date": "2026-09-29",

  "assets": {
    "directory": "./dist",
    // Una ruta que no existe responde 404 con dist/404.html (scripts/prerender.js).
    // Antes respondía 200 con la portada, y Google lo marca como "soft 404".
    "not_found_handling": "404-page"
  },

  // Dominio propio (registrado en esta misma cuenta de Cloudflare). Cada deploy
  // lo mantiene conectado; Cloudflare crea el DNS y el certificado solo.
  "routes": [
    { "pattern": "novamindflow.com", "custom_domain": true },
    { "pattern": "www.novamindflow.com", "custom_domain": true }
  ],
  // Producción se sirve solo en el dominio propio: el webfont de Agenor Neue
  // tiene licencia para un dominio y no debe quedar también en
  // nova.mindflow16.workers.dev. Las vistas previas de cada rama siguen en
  // workers.dev porque preview_urls va explícito; si se omitiera, seguiría a
  // workers_dev y quedarían apagadas.
  "workers_dev": false,
  "preview_urls": true,

  "previews": {}
}